# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.

# Meta Model API key (https://dev.meta.ai). Used server-side only, for
# Muse Spark (bill reading, explanations), SAM 3.1 (roof segmentation)
# and Muse Voice Transcribe (voice questions).
MODEL_API_KEY=

# Contact email sent in the User-Agent header to OpenStreetMap Nominatim,
# as its usage policy requires. Use a real address you check.
NOMINATIM_CONTACT_EMAIL=
