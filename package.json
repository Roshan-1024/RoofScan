{
  "name": "roofscan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "eval:bills": "vitest run --config vitest.eval.config.mts src/lib/bill-reading",
    "eval:assistant": "vitest run --config vitest.eval.config.mts src/lib/assistant"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "d3-contour": "4.0.2",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "openai": "7.34.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-contour": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Rooftop solar and rainwater check for Indian households under PM Surya Ghar.",
